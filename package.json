    "test:code": "node tests/code.cjs",
    "start": "electron .",
    "package": "node scripts/package.mjs",
    "test:template": "node tests/template.cjs",
    "test:yaml": "node tests/yaml.cjs",
    "test:position": "node tests/position.cjs",
    "test:tabs": "node tests/tabs.cjs",
    "test:source": "node tests/source.cjs",
    "test:zoom": "node tests/zoom.cjs",
    "test:compare": "node tests/compare.cjs",
    "test:naming": "node tests/naming.cjs",
    "test:mindmap": "node tests/mindmap.cjs",
    "test:mindmap-interaction": "node tests/mindmap-interaction.cjs",
    "test:mindmap-style": "node tests/mindmap-style.cjs",
    "test:mindmap-open": "node tests/mindmap-open.cjs",
    "test:recovery": "node tests/recovery.electron.cjs",
    "test:recovery-close": "node tests/recovery-close.cjs",
    "test:recovery-map": "node tests/recovery-map.cjs",
    "test:windows": "node tests/windows.electron.cjs",
    "test:windows-dpi": "node tests/windows-dpi.cjs",
    "test:language": "node tests/language.cjs",
    "test:mindmap-features": "node tests/mindmap-features.cjs"
